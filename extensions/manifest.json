{
  "manifest_version": 3,
  "name": "ページ情報をコピー",
  "version": "1.0.0",
  "description": "現在開いているページのタイトルとURLをコピーします。",
  "permissions": ["activeTab", "clipboardWrite"],
  "icons": {
    "16": "icons/clipboard-link-transparent/icon16.png",
    "32": "icons/clipboard-link-transparent/icon32.png",
    "48": "icons/clipboard-link-transparent/icon48.png",
    "128": "icons/clipboard-link-transparent/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/clipboard-link-transparent/icon16.png",
      "32": "icons/clipboard-link-transparent/icon32.png"
    },
    "default_title": "ページ情報をコピー",
    "default_popup": "popup.html"
  }
}
